# Large or sensitive game binaries
*.apk
*.apkm
*.aab
*.obb
*.jks
*.keystore

# ...except drop-in targets staged in incoming/ (tracked, small analysis files only)
!incoming/
!incoming/*.apk
!incoming/*.apks
!incoming/*.txt
!incoming/*.xml
!incoming/*.csv

# Generated analysis output
/extracted/
/original/
/mod-base/

# Local tooling
.gradle/
.idea/
.vscode/
*.log
*.tmp
